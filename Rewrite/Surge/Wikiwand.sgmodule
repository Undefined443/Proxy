#!name=Wikiwand Redirect
#!desc=Redirect wikipedia.org to wikiwand.com
#!author=Xiao Li
#!repo=https://github.com/undefined443/proxy
#!category=Utility

[URL Rewrite]
^https?:\/\/en\.(m\.)?wikipedia\.org\/(wiki)? https://www.wikiwand.com/en 302
^https?:\/\/zh\.(m\.)?wikipedia\.org\/(zh-hans|zh-sg|zh-cn|zh(?=/)|wiki) https://www.wikiwand.com/zh-cn 302

[MITM]
hostname = %APPEND% *.wikipedia.org
