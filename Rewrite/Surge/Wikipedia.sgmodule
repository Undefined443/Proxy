#!name=Wikipedia Redirect
#!desc=Redirect zh.wikipedia.org to zh-cn
#!repo=https://github.com/undefined443/proxy
#!category=Utility

[URL Rewrite]
^https?:\/\/zh\.(m\.)?wikipedia\.org\/(zh-(hans|hant|hk|mo|my|sg|tw)|zh(?=/))\/ https://zh.$1wikipedia.org/zh-cn/ 302

[MITM]
hostname = %APPEND% *.wikipedia.org
