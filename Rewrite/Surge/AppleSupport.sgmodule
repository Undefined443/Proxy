#!name=Apple Support Redirect
#!desc=Redirect support.apple.com/zh-xx to zh-cn
#!author=Xiao Li
#!repo=https://github.com/undefined443/proxy
#!category=Utility

[URL Rewrite]
^https?:\/\/support\.apple\.com\/zh-(hk|mo|sg|tw) https://support.apple.com/zh-cn 302

[MITM]
hostname = %APPEND% support.apple.com
