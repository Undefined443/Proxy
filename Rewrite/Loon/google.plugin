#!name=Google Redirect
#!desc=Redirect google.cn and related domains to google.com
#!author=Xiao Li
#!homepage=https://github.com/undefined443/Proxy

[URL Rewrite]
^https?:\/\/(www\.)?(g|google)\.cn(.*) https://www.google.com/ncr$3 302
^https:\/\/www\.google\.com\.hk(.*) https://www.google.com/ncr$1 302
^https:\/\/www\.google\.co\.jp(.*) https://www.google.com/ncr$1 302

[MITM]
hostname = *.g.cn, *.google.cn, *.google.com.hk, *.google.co.jp
