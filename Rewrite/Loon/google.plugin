#!name=Google Redirect
#!desc=Redirect google.cn and related domains to google.com
#!author=undefined443
#!homepage=https://github.com/undefined443/Proxy
#!icon=https://www.google.com/s2/favicons?domain=google.com&sz=128

[URL Rewrite]
^https?:\/\/(www\.)?(g|google)\.cn(\/.*)? https://www.google.com$3 302
^https:\/\/www\.google\.com\.hk(\/.*)? https://www.google.com$1 302
^https:\/\/www\.google\.co\.jp(\/.*)? https://www.google.com$1 302

[MITM]
hostname = *.g.cn, *.google.cn, *.google.com.hk, *.google.co.jp
